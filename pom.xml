<project
        xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <packaging>pom</packaging>

    <groupId>com.glisterbyte</groupId>
    <artifactId>mysingingmonsters</artifactId>
    <version>0.1.0</version>

    <name>My Singing Monsters Tools</name>
    <description>Unofficial tools for My Singing Monsters</description>
    <url>https://github.com/glistermelon/mysingingmonsters-client</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>glistermelon</name>
            <email>glisterm3lon@gmail.com</email>
            <url>https://glisterbyte.com</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/glistermelon/mysingingmonsters-client.git</connection>
        <developerConnection>scm:git:ssh://github.com:glistermelon/mysingingmonsters-client.git</developerConnection>
        <url>http://github.com/glistermelon/mysingingmonsters-client/tree/master</url>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>mysingingmonsters-client</module>
        <module>mysingingmonsters-client-tools</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.cdimascio</groupId>
                <artifactId>java-dotenv</artifactId>
                <version>5.2.2</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>0.10.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>

                <executions>
                    <execution>
                        <id>gpg-sign</id>
                        <phase>verify</phase>
                        <goals><goal>sign</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <excludeArtifacts>
                        <artifact>com.glisterbyte.mysingingmonsters-client-tools</artifact>
                    </excludeArtifacts>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>